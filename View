-- Urutan rarity dari terendah ke tertinggi
local RARITY_ORDER = {
    "Common", "Uncommon", "Rare", "Epic", "Legendary",
    "Mythic", "Cosmic", "Secret", "Eternal", "Divine"
}

-- Fungsi bantu: cek rarity berdasarkan nama pet
local function getRarityFromPet(petName)
    for biome, rarities in pairs(RARITY_DB) do
        if biome == "DemonsAngels" then
            for side, sides in pairs(rarities) do
                for rarity, pets in pairs(sides) do
                    for _, name in ipairs(pets) do
                        if string.lower(name) == string.lower(petName) then
                            return rarity, biome, side
                        end
                    end
                end
            end
        else
            for rarity, pets in pairs(rarities) do
                for _, name in ipairs(pets) do
                    if string.lower(name) == string.lower(petName) then
                        return rarity, biome, nil
                    end
                end
            end
        end
    end
    return "Common", "Unknown", nil
end

-- Fungsi bantu: dapetin index rarity (buat prioritas)
local function getRarityIndex(rarity)
    for i, r in ipairs(RARITY_ORDER) do
        if string.lower(r) == string.lower(rarity) then
            return i
        end
    end
    return 1
end

