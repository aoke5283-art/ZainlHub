    -- ============================================================
    -- LOGIC: FILTER CHECK (pake RARITY_DB)
    -- ============================================================
    local function isTarget(egg)
        if not egg:IsA("BasePart") then return false end
        
        local eggName = egg.Name
        local value = egg:GetAttribute("Value") or egg:GetAttribute("value") or 0
        local size = egg:GetAttribute("Size") or egg:GetAttribute("size") or 0
        local mutation = egg:GetAttribute("Mutation") or egg:GetAttribute("mutation") or "None"
        
        -- Cek Min Value & Size
        if value < Config.MinValue then return false end
        if size < Config.MinSize then return false end
        
        -- Cek Rarity dari database
        local rarity, biome, side = getRarityFromPet(eggName)
        if not rarity then return false end
        
        -- Cek apakah rarity termasuk target
        local rarityMatch = false
        for _, r in ipairs(Config.TargetRarity) do
            if string.lower(rarity) == string.lower(r) then
                rarityMatch = true
                break
            end
        end
        if not rarityMatch then return false end
        
        -- Cek mutation (kalo target mutation di-set)
        if #Config.TargetMutation > 0 then
            local mutMatch = false
            for _, m in ipairs(Config.TargetMutation) do
                if string.lower(mutation) == string.lower(m) then
                    mutMatch = true
                    break
                end
            end
            if not mutMatch and string.lower(mutation) ~= "none" then
                return false
            end
        end
        
        return true, rarity, biome, side
    end
    
    -- ============================================================
    -- LOGIC: ESP UPDATE
    -- ============================================================
    local function updateESP()
        for _, egg in pairs(EggsFolder:GetChildren()) do
            local oldESP = egg:FindFirstChild("ZainlESP")
            if oldESP then oldESP:Destroy() end
            
            local isTargetEgg, rarity, biome, side = isTarget(egg)
            if Config.ESPEnabled and isTargetEgg then
                local mutation = egg:GetAttribute("Mutation") or "None"
                local value = egg:GetAttribute("Value") or 0
                local size = egg:GetAttribute("Size") or 0
                
                local distance = 0
                if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                    distance = (plr.Character.HumanoidRootPart.Position - egg.Position).Magnitude
                end
                
                local lines = {}
                table.insert(lines, "🥚 " .. egg.Name)
                if Config.ESPShowRarity then
                    table.insert(lines, "Rarity: " .. rarity .. (side and (" (" .. side .. ")") or ""))
                end
                if Config.ESPShowMutation then
                    table.insert(lines, "Mutation: " .. mutation)
                end
                if Config.ESPShowValue then
                    table.insert(lines, "Value: $" .. tostring(value))
                end
                if Config.ESPShowSize then
                    table.insert(lines, string.format("Size: %.1f KG", size))
                end
                if Config.ESPShowDistance then
                    table.insert(lines, string.format("Distance: %.1f", distance))
                end
                if biome then
                    table.insert(lines, "Biome: " .. biome)
                end
                
                local bb = Instance.new("BillboardGui", egg)
                bb.Name = "ZainlESP"
                bb.Size = UDim2.new(0, 240, 0, 110)
                bb.StudsOffset = Vector3.new(0, 4, 0)
                bb.AlwaysOnTop = true
                
                local txt = Instance.new("TextLabel", bb)
                txt.Size = UDim2.new(1, 0, 1, 0)
                txt.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                txt.BackgroundTransparency = 0.3
                txt.TextColor3 = Color3.fromRGB(255, 221, 0)
                txt.TextScaled = true
                txt.Font = Enum.Font.GothamBold
                txt.Text = table.concat(lines, "\n")
                Instance.new("UICorner", txt).CornerRadius = UDim.new(0, 6)
            end
        end
    end
    
    -- ============================================================
    -- LOGIC: AUTO STEAL
    -- ============================================================
    local function autoSteal()
        local bestEgg = nil
        local bestScore = -1
        
        for _, egg in pairs(EggsFolder:GetChildren()) do
            local isTargetEgg, rarity, biome, side = isTarget(egg)
            if isTargetEgg then
                local value = egg:GetAttribute("Value") or 0
                local rarityIdx = getRarityIndex(rarity)
                
                local score = value
                if Config.PrioritizeRarity then
                    score = score + (rarityIdx * 100000)
                end
                if Config.PrioritizeSecret and string.lower(rarity) == "secret" then
                    score = score + 5000000
                end
                
                if score > bestScore then
                    bestScore = score
                    bestEgg = egg
                end
            end
        end
        
        if bestEgg then
            local stealRemote = RS:FindFirstChild("StealEgg") 
                or RS:FindFirstChild("CollectEgg")
                or RS:FindFirstChild("TakeEgg")
                or RS:FindFirstChild("GrabEgg")
            
            if stealRemote and stealRemote:IsA("RemoteEvent") then
                stealRemote:FireServer(bestEgg)
                
                local val = bestEgg:GetAttribute("Value") or 0
                Config.TotalStolen = Config.TotalStolen + 1
                Config.TotalValue = Config.TotalValue + val
                
                if Config.WebhookEnabled and Config.WebhookURL ~= "" and val >= Config.WebhookMinValue then
                    ZainlHub:SendWebhook(bestEgg)
                end
                
                return true
            end
        end
        return false
    end
    
    -- ============================================================
    -- LOGIC: WEBHOOK
    -- ============================================================
    function ZainlHub:SendWebhook(egg)
        if not Config.WebhookURL or Config.WebhookURL == "" then return end
        
        local rarity, biome, side = getRarityFromPet(egg.Name)
        local mutation = egg:GetAttribute("Mutation") or "None"
        local value = egg:GetAttribute("Value") or 0
        local size = egg:GetAttribute("Size") or 0
        
        local embed = {
            ["title"] = "🥚 ZAINL HUB - Rare Egg Stolen!",
            ["description"] = "**" .. egg.Name .. "** has been stolen!",
            ["color"] = 0xFF50A0,
            ["fields"] = {
                {["name"] = "Rarity", ["value"] = rarity .. (side and (" (" .. side .. ")") or ""), ["inline"] = true},
                {["name"] = "Biome", ["value"] = biome or "Unknown", ["inline"] = true},
                {["name"] = "Mutation", ["value"] = mutation, ["inline"] = true},
                {["name"] = "Value", ["value"] = "$" .. tostring(value), ["inline"] = true},
                {["name"] = "Size", ["value"] = string.format("%.1f KG", size), ["inline"] = true}
            },
            ["footer"] = {
                ["text"] = "ZAINL HUB v2.1 | " .. os.date("%Y-%m-%d %H:%M:%S")
            }
        }
        
        local payload = {
            ["content"] = "🎯 **ZAINL HUB ALERT**",
            ["embeds"] = {embed}
        }
        
        pcall(function()
            HttpService:PostAsync(
                Config.WebhookURL,
                HttpService:JSONEncode(payload),
                Enum.HttpContentType.ApplicationJson
            )
        end)
    end
    
    -- ============================================================
    -- MAIN LOOP
    -- ============================================================
    local lastSteal = 0
    RunService.Heartbeat:Connect(function()
        if Config.ESPEnabled then
            updateESP()
        end
        
        if Config.AutoSteal and tick() - lastSteal >= Config.AutoStealInterval then
            lastSteal = tick()
            autoSteal()
        end
        
        stolenLabel.Text = "🥚 Stolen: " .. Config.TotalStolen
        valueLabel.Text = "💰 Value: $" .. Config.TotalValue
        local elapsed = os.time() - Config.SessionStart
        timeLabel.Text = "⏱️ Session: " .. elapsed .. "s"
        
        if Config.AutoSteal then
            statusText.Text = "🟢 Auto Steal Active - Scanning..."
        elseif Config.ESPEnabled then
            statusText.Text = "🔵 ESP Active - Displaying egg info"
        else
            statusText.Text = "⚪ Idle - Waiting for eggs..."
        end
    end)
    
    print("[ZAINL HUB] v2.1 Loaded - Rarity DB: Forest → Demons & Angels")
end

